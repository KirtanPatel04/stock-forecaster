# Alpaca Markets (https://alpaca.markets/ — free account, use IEX feed)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Polygon.io (https://polygon.io/ — fallback, free tier)
POLYGON_API_KEY=your_polygon_api_key_here

# Finnhub (https://finnhub.io/ — free tier, news + earnings)
FINNHUB_API_KEY=your_finnhub_api_key_here

# AI — use either one (Gemini is checked first)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLite database path
DATABASE_URL=sqlite:///./stock_forecaster.db

# Set to true for verbose logging
DEBUG=false
